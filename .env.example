FRED_API_KEY=your_fred_api_key_here
# EIA_API_KEY=your_eia_api_key_here

# === AI 分析 (DeepSeek) ===
# 同一组配置用于新闻结构化分析和每日AI趋势日报
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
# 结构化摘要默认关闭思考模式，避免输出预算耗尽后 JSON 被截断。
AI_THINKING_MODE=disabled
AI_ANALYZE_MAX_TOKENS=4096
AI_TRADE_REVIEW_MAX_TOKENS=2400
AI_TRADE_PLAN_MAX_TOKENS=2600
AI_DAILY_MAX_TOKENS=8192
# 新闻事件候选簇的 AI 合并与统一结论；未配置 AI key 时，高相似度重复事件仍会规则兜底合并。
AI_NEWS_CLUSTER_MERGE_ENABLED=true
AI_NEWS_CLUSTER_MAX_TOKENS=1600
# 事件流只会把有具体标题/实体证据的报道合并；超过上限时不会自动回收旧簇。
NEWS_CLUSTER_MAX_ARTICLES=1000
NEWS_CLUSTER_EVENT_MAX_HOURS=96
NEWS_CLUSTER_MATCH_THRESHOLD=3.0
NEWS_CLUSTER_WARN_ARTICLES=25
# 相同标题在该窗口内已完成 AI 分析时，保留原文但跳过重复 AI 调用。
NEWS_ANALYSIS_DEDUP_DAYS=3
# 首页市场简报的短文本解读；数据未变化时在进程内缓存，避免重复调用。
AI_MARKET_BRIEF_MAX_TOKENS=1200
AI_MARKET_BRIEF_CACHE_SECONDS=1800

# === 新闻源 ===
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
# 免费 Key 约 25 次/日；默认不在每小时新闻任务中调用，避免持续限流。
# 如需启用，保持每次最多 1 个主题，并确认总调用量不超过额度。
ALPHA_VANTAGE_NEWS_ENABLED=false
ALPHA_VANTAGE_NEWS_TOPICS=financial_markets
ALPHA_VANTAGE_NEWS_MAX_REQUESTS_PER_RUN=1
# RSS 原文每 15 分钟刷新一次；整点任务再做 AI 分析。
NEWS_FAST_REFRESH_MINUTES=15
RSS_MAX_ENTRIES_PER_FEED=30
NEWS_HTTP_TIMEOUT_SECONDS=20
# SEC 对 User-Agent 较敏感；生产环境建议填项目名和联系邮箱。
# NEWS_USER_AGENT=macro-dashboard/1.0 (contact: your-email@example.com)
# 财新没有稳定直连的官方 RSS。仅在自行确认接受第三方镜像风险后显式启用；
# 留空时不抓取财新镜像，也不会影响宏观看板或告警。
# CAIXIN_RSS_MIRROR_URL=https://rss.ovh/caixin/latest
# 候选源探测脚本读取但不会写入这些值；只有实测通过后才会接入正式抓取链。
# FINNHUB_API_KEY=
# Tushare: cn_m（M2同比）需要 600 积分；sf_month（社融）和 repo_daily（DR007）需要 2000 积分。
# TUSHARE_TOKEN=

# === 看板/cpolar 可用性监控 ===
# 公网 URL 必须填写 cpolar 为 8501 隧道生成的 http/https 地址，才能发现隧道 inactive。
CPOLAR_HEALTH_ENABLED=true
CPOLAR_PUBLIC_URL=https://your-cpolar-dashboard-url.example
CPOLAR_LOCAL_URL=http://127.0.0.1:8501
CPOLAR_HEALTH_CHECK_MINUTES=5
CPOLAR_HEALTH_TIMEOUT_SECONDS=15
# P0/P1 统一健康检查阈值
HEALTH_HTTP_TIMEOUT_SECONDS=10
# 服务重启后先等待 API / Streamlit / cpolar 完成就绪，再执行首个 P0 检查。
HEALTH_INITIAL_CHECK_DELAY_SECONDS=45
HEALTH_STARTUP_GRACE_MINUTES=10
HEALTH_DATA_MAX_AGE_SECONDS=43200
HEALTH_NEWS_MAX_AGE_SECONDS=10800
HEALTH_DATA_SOURCE_MAX_AGE_SECONDS=43200
# 只有这些核心源在“无新鲜有效数据”时才升级为严重告警；可选/已停用源仅提醒。
HEALTH_CRITICAL_DATA_SOURCES=fred,crypto_liquidity,crypto_market
HEALTH_RSS_SOURCE_MAX_AGE_SECONDS=21600
HEALTH_MIN_FREE_BYTES=524288000
HEALTH_MIN_FREE_PERCENT=10
HEALTH_BACKUP_MAX_AGE_SECONDS=129600
HEALTH_AI_FAILED_ARTICLES_MAX=5
HEALTH_AI_FAILURE_RECENT_SECONDS=86400
HEALTH_NOTIFICATION_STATUS_MAX_AGE_SECONDS=86400

# === OKX 只读交易看板 ===
# API 权限必须只勾选 Read；建议同时设置 OKX IP 白名单。不要把真实密钥提交到 Git。
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_API_BASE_URL=https://www.okx.com
OKX_API_DEMO=false
OKX_ACCOUNT_LABEL=main
OKX_INST_TYPE=SWAP
# OKX acctLv=3 表示 Multi-currency margin；不符合时仍可读取，但页面会提示。
OKX_REQUIRED_ACCOUNT_LEVEL=3
OKX_SYNC_LIMIT=100
OKX_API_TIMEOUT_SECONDS=15

# === Crypto 资金流（可选，CSV/JSON URL；字段需包含 date 和 flow/net_flow） ===
# BTC_ETF_FLOWS_URL=https://your-provider.example/btc-etf-flows.csv
# BTC_EXCHANGE_NETFLOW_URL=https://your-provider.example/btc-exchange-netflow.csv

# === 翻译 (腾讯云机器翻译) ===
TENCENTCLOUD_SECRET_ID=AKIDxxxxxxxx
TENCENTCLOUD_SECRET_KEY=xxxxxxxx

# === 推送 ===
TELEGRAM_BOT_TOKEN=123456:ABC
TELEGRAM_CHAT_ID=789012
NOTIFY_CHANNELS=telegram
# 可选：telegram,lark,email,webhook；逗号两侧空格会自动忽略
NOTIFY_ON_TASK_FAILURE=true
# AI 或其他任务捕获异常并回退时也发送运行告警；相同错误默认 15 分钟内去重
NOTIFY_ON_RUNTIME_ERROR=true
RUNTIME_ERROR_NOTIFY_COOLDOWN_SECONDS=900

# === 飞书/Lark 自定义机器人（可选） ===
# 将机器人 Webhook 与可选的“签名校验”密钥填写在服务器 .env；不要提交真实值。
# 使用 NOTIFY_CHANNELS=lark 或 NOTIFY_CHANNELS=telegram,lark 启用。
LARK_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token
# LARK_WEBHOOK_SECRET=your-signing-secret
# 用于日报/告警卡片的“打开宏观看板”按钮，可不填。
# DASHBOARD_PUBLIC_URL=https://macro.example.com

# === 紧急新闻推送（默认开启；只推送首次出现的高影响事件簇） ===
# 首次启动默认使用以下值；在网页“通知规则”页保存后，以网页保存的规则为准。
NEWS_ALERT_ENABLED=true
NEWS_ALERT_MIN_SEVERITY=4
NEWS_ALERT_MIN_CONFIDENCE=0.75
NEWS_ALERT_MIN_ARTICLES=1
NEWS_ALERT_MAX_AGE_MINUTES=90
# 可选：只推送指定事件类型或资产；留空表示不筛选。
# NEWS_ALERT_EVENT_TYPES=geopolitics,fed_policy,credit,crypto
# NEWS_ALERT_ASSETS=BTC,Oil,DXY

# === 可选 ===
# WEBHOOK_URL=https://hooks.slack.com/xxx
# STREAMLIT_PORT=8501

# === 服务部署 ===
# 看板访问保护：不配置时所有网页操作保持只读；建议使用随机长密码并确保 .env 权限为 600。
# 也可以使用 `python -m services.access_control` 生成 PBKDF2 哈希，配置 HASH 后删除明文密码。
# DASHBOARD_ADMIN_PASSWORD=replace_with_a_long_random_password
# DASHBOARD_ADMIN_PASSWORD_HASH=pbkdf2_sha256$310000$...
DASHBOARD_ADMIN_SESSION_MINUTES=60
# 受保护 API 的 Bearer Token。请使用随机长字符串，不要提交真实 Token。
API_AUTH_TOKEN=replace_with_a_long_random_token
API_HOST=127.0.0.1
API_PORT=8080
STREAMLIT_PORT=8501
API_STATUS_COOLDOWN_SECONDS=5
API_REFRESH_COOLDOWN_SECONDS=300
API_CONTEXT_COOLDOWN_SECONDS=300
API_REPORT_COOLDOWN_SECONDS=300
API_BACKUP_COOLDOWN_SECONDS=300
SCHEDULER_TIMEZONE=Asia/Shanghai
RUNTIME_LOCK_DIR=runtime/locks
TASK_LOCK_STALE_SECONDS=3600
TASK_RETRY_ATTEMPTS=2
TASK_RETRY_BASE_SECONDS=5
DATA_REFRESH_TIMEOUT_SECONDS=1800
NEWS_REFRESH_TIMEOUT_SECONDS=600
DAILY_CONTEXT_TIMEOUT_SECONDS=900
DAILY_REPORT_TIMEOUT_SECONDS=1200
WEEKLY_REPORT_TIMEOUT_SECONDS=1200
BACKUP_TIMEOUT_SECONDS=300
STARTUP_RECOVERY_ENABLED=true
STARTUP_RECOVERY_DATA_MAX_AGE_SECONDS=28800
STARTUP_RECOVERY_NEWS_MAX_AGE_SECONDS=7200
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
BACKUP_DIR=backups
BACKUP_AFTER_DAILY_REPORT=true
BACKUP_RETENTION_COUNT=14
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_FREE_BYTES=104857600
UVICORN_LOG_LEVEL=info

# === SQLite 并发/锁等待 ===
SQLITE_TIMEOUT_SECONDS=60
SQLITE_BUSY_TIMEOUT_MS=60000
SQLITE_RETRY_ATTEMPTS=5
SQLITE_RETRY_BASE_SLEEP=0.2
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
